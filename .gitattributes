# License evidence is checksum-addressed and must retain its audited bytes on
# Windows too. This does not change line-ending policy for application source.
third-party/** -text
# Preserve the compiler distribution's original HTML, including its whitespace.
third-party/RUST-STDLIB-LICENSES.html -whitespace
# Preserve these upstream references verbatim, including their whitespace.
third-party/sources/gcc-14.2.0-* -whitespace
# Patch context includes required spaces; preserve these checksum-pinned bytes.
third-party/runtime/*.patch -whitespace
packaging/appimage-tools.json text eol=lf
# The replacement helper source kit is hashed on both Windows and Unix hosts.
packaging/nsis/** text eol=lf
packaging/nsis_helpers.py text eol=lf
packaging/windows_crt.py text eol=lf
packaging/windows_runtime.py text eol=lf
packaging/windows-runtime.json text eol=lf
third-party/nsis/*.patch -whitespace
# Keep the native Windows audit bytes without flagging CRLF as trailing space.
third-party/nsis-build-audit.json whitespace=cr-at-eol
